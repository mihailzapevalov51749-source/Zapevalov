# Multi-frontend launch (Step 18.12.3)
#
# | Environment | npm script       | Frontend port | Backend URL              |
# |-------------|------------------|---------------|--------------------------|
# | DEV         | npm run dev      | 5173          | http://127.0.0.1:8010    |
# | TEMPLATE    | npm run dev:template | 5174      | http://127.0.0.1:8011    |
# | CLIENT      | npm run dev:client   | 5175      | http://127.0.0.1:8012    |
#
# DEV (vite --mode development)
VITE_API_BASE_URL=http://127.0.0.1:8010

# TEMPLATE (npm run dev:template)
# VITE_API_BASE_URL=http://127.0.0.1:8011

# CLIENT (npm run dev:client)
# VITE_API_BASE_URL=http://127.0.0.1:8012