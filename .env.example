# Example local configuration (copy to .env and adjust).
#
# DATABASE_URL is NOT set here. Working database assignment is defined only in:
#   scripts/dev-stack/manifest.yaml
#
# Start backends via dev-stack — it injects the correct DATABASE_URL per contour:
#   DEV      → yasnopro_dev
#   TEMPLATE → yasnopro_template
#   CLIENT   → yasnopro_client
#
# Legacy database portal_constructor_v2 must not be used for DEV/TEMPLATE/CLIENT.
# See ADR-INFRA-001-legacy-database-isolation.md

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

PORTAL_LOGIN_URL=http://localhost:5173/login
